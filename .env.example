# Copy this file to .env and change the values. Never commit .env to git.

# --- Basics -----------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# In production, for example:
# DEBUG=False
# ALLOWED_HOSTS=kamkarao.com,www.kamkarao.com
# CSRF_TRUSTED_ORIGINS=https://kamkarao.com,https://www.kamkarao.com
SITE_URL=http://127.0.0.1:8000

# --- Database ---------------------------------------------------------------
# Leave empty to use SQLite (db.sqlite3) on your laptop.
# DATABASE_URL=postgres://kamkarao:password@localhost:5432/kamkarao

# --- OTP / SMS ----------------------------------------------------------------
# none    = no OTP: customer just enters the number (early stage, no SMS cost, no DLT needed)
# console = OTP is printed in the terminal and shown on screen (testing on your laptop only)
# msg91   = real SMS. Needs DLT registration and an approved OTP template.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Business rules ---------------------------------------------------------
# Your support WhatsApp number with country code, digits only (e.g. 919876543210)
SUPPORT_WHATSAPP=
DAILY_REVEAL_LIMIT=20
NEARBY_ONLY_KM=2.5

# --- Photo storage (optional) -------------------------------------------------
# Leave S3_BUCKET empty to keep photos on the server's disk.
# Cloudflare R2 example:
# S3_BUCKET=kamkarao-public
# S3_PRIVATE_BUCKET=kamkarao-ids
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PUBLIC_DOMAIN=media.kamkarao.com

# --- Server with docker compose only ---------------------------------------
DOMAIN=kamkarao.com
POSTGRES_PASSWORD=change-me-too
